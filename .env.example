# ==================== LLM（provider 适配层，EU 切换 = 纯配置变更） ====================
DEEPSEEK_API_KEY=sk-xxxxxxxx       # 兼容旧变量；LLM_API_KEY 未设置时回退读它
LLM_PROVIDER=openai_compat         # openai_compat | azure | bedrock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx            # 切换 EU 服务商：改 LLM_BASE_URL + LLM_API_KEY + LLM_MODEL 即可
LLM_MODEL=deepseek-chat
# AZURE_OPENAI_ENDPOINT=           # LLM_PROVIDER=azure 时使用
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-06-01
# BEDROCK_MODEL_ID=                # LLM_PROVIDER=bedrock 时使用（SigV4 走 EC2 实例角色/密钥）

# ==================== 向量库 ====================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=请改成随机强密钥        # 生产必填（2026-08 起无硬编码默认值）

# ==================== 多语言向量模型 ====================
EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
EMBEDDING_MODEL_PATH=backend/models/gte-multilingual-base
EMBEDDING_DEVICE=cpu                  # cpu | auto | cuda
EMBEDDING_NORMALIZE=true
EMBEDDING_MODEL_REVISION=9bbca17d9273fd0d03d5725c7a4b0f6b45142062
ANCHOR_MATCH_THRESHOLD=0.60      # GTE cosine threshold for overseas-to-CN anchor matching
ANCHOR_MATCH_UNCATEGORIZED_THRESHOLD=0.75  # no category: stricter false-match guard

# ==================== 合规数据库（审计/trace/lineage/DSAR，Postgres） ====================
# 本地 dev 不需要；docker compose 里 backend 会自动注入容器内 DATABASE_URL
# DATABASE_URL=postgresql://joytag:xxx@localhost:5432/joytag

# ==================== Keycloak SSO（2026-08 起，生产 AUTH_ENABLED=true） ====================
AUTH_ENABLED=false                  # 本地 dev=false；生产 compose 自动置 true
OIDC_ISSUER=http://localhost:8080/realms/joytag            # 本地默认；生产改为实际外部地址
OIDC_JWKS_URL=http://localhost:8080/realms/joytag/protocol/openid-connect/certs
OIDC_TOKEN_URL=http://localhost:8080/realms/joytag/protocol/openid-connect/token
SESSION_SECRET=                     # 生产必填：openssl rand -hex 32
# TLS_ENABLED=false                 # 域名 + Caddy TLS 就绪后置 true（cookie Secure）

# ==================== 假名化（Presidio，LLM 发送前） ====================
# PII_GUARD_MODE=regex_only         # 默认 regex_only（无需 spaCy 模型）；off 可关闭

# ==================== Docker Compose 基础设施密钥（生产必填） ====================
POSTGRES_PASSWORD=请改成随机强密钥       # postgres 超级用户
JOYTAG_DB_PASSWORD=请改成随机强密钥      # 应用角色（审计/trace 表）
KEYCLOAK_DB_PASSWORD=请改成随机强密钥    # keycloak 库角色
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=请改成随机强密钥  # Keycloak 管理控制台

# ==================== 其它 ====================
# CORS_ORIGINS=                  # 默认空（同源内嵌管理页无需 CORS；外部跨域调用方按需配置）
# SOCIAL_MEDIA_PROXY=http://127.0.0.1:7890   # legacy：Reddit 模块已删除，此变量无消费方
# HF_ENDPOINT=https://hf-mirror.com  # 无法直连 huggingface.co 时使用国内镜像
